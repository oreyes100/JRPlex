# Copy with: node scripts/install.mjs --mode compose (Linux) or --mode native.
# This file contains NO credentials. Never add cloud tokens or passwords here.
COMPOSE_PROJECT_NAME=jrplex
JELLYFIN_IMAGE=ghcr.io/jellyfin/jellyfin:12.2
CADDY_IMAGE=caddy:2.11.7-alpine
QB_IMAGE=lscr.io/linuxserver/qbittorrent:5.2.4_v2.0.15-ls480
JRP_UID=1000
JRP_GID=1000
JRP_DATA_DIR=./runtime
LOCAL_MEDIA=./runtime/media/local
CLOUD_MEDIA=./runtime/media/cloud
DOWNLOADS_COMPLETE=./runtime/downloads/complete
DOWNLOADS_INCOMPLETE=./runtime/downloads/incomplete
TORRENT_FILES_DIR=./runtime/downloads/incomplete
TORRENT_SAVE_PATH=./runtime/downloads/incomplete
# Set a real URL BEFORE publication. Local HTTP is allowed only on loopback.
PUBLIC_URL=http://127.0.0.1:8787
CADDY_DOMAIN=localhost
# Compose overrides these three values inside the gateway container.
JELLYFIN_URL=http://127.0.0.1:8096
HOST=127.0.0.1
PORT=8787
SESSION_TTL=28800
# Optional for bare Node; Compose sets /var/lib/jrplex/tv and mounts private runtime/tv.
# TV_STATE_DIR=/absolute/private/path/tv
# Exact socket peer IPs allowed to supply X-Real-IP. Never trust arbitrary XFF.
# Compose behind host nginx: discover the gateway of the jrplex_media network.
TRUSTED_PROXY_IPS=
# Leave QB_URL empty unless the optional torrent service is configured.
# Compose: http://qbittorrent:8080 ; native: http://127.0.0.1:8080
QB_URL=
QB_USERNAME_FILE=./runtime/secrets/qb-username
QB_PASSWORD_FILE=./runtime/secrets/qb-password
# Google Web OAuth is optional. On the VPS, use deploy/compose.google-drive.yaml;
# it defaults to the external private paths created by scripts/google-drive-prepare.mjs.
