<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.jrplex.gateway</string>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/JRPlex</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>--env-file=/ABSOLUTE/PATH/JRPlex/.env</string>
    <string>/ABSOLUTE/PATH/JRPlex/server.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/JRPlex/runtime/gateway.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/JRPlex/runtime/gateway.stderr.log</string>
</dict></plist>
